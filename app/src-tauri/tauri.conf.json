{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "猫咪盒子启动器",
  "version": "0.3.2-dev.1",
  "mainBinaryName": "nekocrate-launcher",
  "identifier": "dev.nekocrate.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "猫咪盒子启动器",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "shortDescription": "跨平台 Minecraft Java 启动器",
    "category": "Game",
    "publisher": "NekoOS Group",
    "homepage": "https://github.com/NekoOS-Group/NekoCrate-Launcher",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "GPL-3.0-only"
  }
}
